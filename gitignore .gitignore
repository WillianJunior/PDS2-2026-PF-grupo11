# Ignorar artefatos gerados pelos testes na pasta tests/
# (mantém os fontes .cpp/.h rastreados)
tests/*.exe
tests/*_test
tests/*Tests.exe
tests/*.out
tests/*.obj
tests/*.o
tests/*.dll
tests/*.pdb
tests/*.ilk
tests/*.log
tests/*.trx
tests/TestResults/
tests/**/TestResults/
tests/*.xml
tests/gcov.*
tests/*.gcda
tests/*.gcno
tests/*.gcov
tests/coverage.*
tests/lcov.info
tests/*.profdata
tests/*.profraw
tests/*.coverdata
tests/.vstest/
tests/.vstest/*

# Arquivos de cobertura e relatórios comuns (em qualquer lugar)
coverage.*
lcov.info
*.coverage
*.coveragexml
.vstest/
.vstest/*

# Não ignorar headers em include (ex: include/doctest.h) -- mantidos no repositório
!include/*.h